{
  "description": "Task-scoped Placekeeper lifecycle hooks.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/Applications/Placekeeper.app/Contents/MacOS/placekeeper\" hook --event",
            "timeout": 8,
            "statusMessage": "Connecting Placekeeper context",
            "additionalContextLimit": 131072
          }
        ]
      },
      {
        "matcher": "^mcp__placekeeper__display_review$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/Applications/Placekeeper.app/Contents/MacOS/placekeeper\" hook --event",
            "timeout": 8,
            "statusMessage": "Verifying Placekeeper native presentation",
            "additionalContextLimit": 131072
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/Applications/Placekeeper.app/Contents/MacOS/placekeeper\" hook --event",
            "timeout": 8,
            "statusMessage": "Refreshing Placekeeper context",
            "additionalContextLimit": 131072
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/Applications/Placekeeper.app/Contents/MacOS/placekeeper\" hook --event",
            "timeout": 3,
            "statusMessage": "Disconnecting Placekeeper context",
            "additionalContextLimit": 256
          }
        ]
      }
    ]
  }
}
