{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdf-proofreader.local/schemas/handoff-v1.schema.json",
  "title": "PDF Proofreader Codex handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewId", "frozenRevision", "createdAt", "sourcePdfSha256", "reviewedPdf", "sourceRoot", "resultDirectory", "revisedPdfDestination", "items"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "reviewId": { "$ref": "#/$defs/uuid" },
    "frozenRevision": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "sourcePdfSha256": { "$ref": "#/$defs/sha256" },
    "reviewedPdf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceRoot": { "$ref": "#/$defs/absolutePath" },
    "resultDirectory": { "$ref": "#/$defs/absolutePath" },
    "revisedPdfDestination": { "$ref": "#/$defs/absolutePath" },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "absolutePath": { "type": "string", "minLength": 2, "maxLength": 4096, "pattern": "^/" },
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*\\u0000).+$" },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" }, "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "sourceHint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line", "confidence", "provenance"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "line": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "confidence": { "enum": ["high", "low"] },
        "provenance": { "const": "synctex" }
      }
    },
    "selectionAnchor": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "quote", "prefix", "suffix"],
      "properties": {
        "kind": { "const": "selection" }, "quote": { "type": "string", "minLength": 1, "maxLength": 100000 },
        "prefix": { "type": "string", "maxLength": 4096 }, "suffix": { "type": "string", "maxLength": 4096 }
      }
    },
    "caretAnchor": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "leftContext", "rightContext"],
      "properties": {
        "kind": { "const": "caret" }, "leftContext": { "type": "string", "maxLength": 4096 }, "rightContext": { "type": "string", "maxLength": 4096 }
      }
    },
    "pageAnchor": {
      "type": "object", "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "page" }, "nearbyText": { "type": "string", "maxLength": 4096 } }
    },
    "coordinates": {
      "type": "object", "additionalProperties": false,
      "required": ["rect"],
      "properties": {
        "rect": { "$ref": "#/$defs/rect" },
        "segmentRects": { "type": "array", "minItems": 1, "maxItems": 10000, "items": { "$ref": "#/$defs/rect" } }
      }
    },
    "selectionCoordinates": {
      "type": "object", "additionalProperties": false,
      "required": ["rect", "segmentRects"],
      "properties": {
        "rect": { "$ref": "#/$defs/rect" },
        "segmentRects": { "type": "array", "minItems": 1, "maxItems": 10000, "items": { "$ref": "#/$defs/rect" } }
      }
    },
    "item": {
      "oneOf": [
        { "$ref": "#/$defs/replaceItem" }, { "$ref": "#/$defs/deleteItem" }, { "$ref": "#/$defs/insertItem" },
        { "$ref": "#/$defs/highlightItem" }, { "$ref": "#/$defs/pageNoteItem" }
      ]
    },
    "replaceItem": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "intent", "pageIndex", "coordinates", "anchor", "payload"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" }, "intent": { "const": "replace" }, "pageIndex": { "type": "integer", "minimum": 0 },
        "coordinates": { "$ref": "#/$defs/selectionCoordinates" }, "anchor": { "$ref": "#/$defs/selectionAnchor" },
        "payload": { "type": "object", "additionalProperties": false, "required": ["proposedText"], "properties": { "proposedText": { "type": "string", "minLength": 1, "maxLength": 100000 } } },
        "sourceHint": { "$ref": "#/$defs/sourceHint" }
      }
    },
    "deleteItem": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "intent", "pageIndex", "coordinates", "anchor", "payload"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" }, "intent": { "const": "delete" }, "pageIndex": { "type": "integer", "minimum": 0 },
        "coordinates": { "$ref": "#/$defs/selectionCoordinates" }, "anchor": { "$ref": "#/$defs/selectionAnchor" },
        "payload": { "type": "object", "additionalProperties": false, "maxProperties": 0 },
        "sourceHint": { "$ref": "#/$defs/sourceHint" }
      }
    },
    "insertItem": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "intent", "pageIndex", "coordinates", "anchor", "payload"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" }, "intent": { "const": "insert" }, "pageIndex": { "type": "integer", "minimum": 0 },
        "coordinates": { "$ref": "#/$defs/coordinates" }, "anchor": { "$ref": "#/$defs/caretAnchor" },
        "payload": { "type": "object", "additionalProperties": false, "required": ["proposedText"], "properties": { "proposedText": { "type": "string", "minLength": 1, "maxLength": 100000 } } },
        "sourceHint": { "$ref": "#/$defs/sourceHint" }
      }
    },
    "highlightItem": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "intent", "pageIndex", "coordinates", "anchor", "payload"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" }, "intent": { "const": "highlight" }, "pageIndex": { "type": "integer", "minimum": 0 },
        "coordinates": { "$ref": "#/$defs/selectionCoordinates" }, "anchor": { "$ref": "#/$defs/selectionAnchor" },
        "payload": { "type": "object", "additionalProperties": false, "properties": { "comment": { "type": "string", "maxLength": 100000 } } },
        "sourceHint": { "$ref": "#/$defs/sourceHint" }
      }
    },
    "pageNoteItem": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "intent", "pageIndex", "coordinates", "anchor", "payload"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" }, "intent": { "const": "pageNote" }, "pageIndex": { "type": "integer", "minimum": 0 },
        "coordinates": { "$ref": "#/$defs/coordinates" }, "anchor": { "$ref": "#/$defs/pageAnchor" },
        "payload": { "type": "object", "additionalProperties": false, "required": ["comment"], "properties": { "comment": { "type": "string", "minLength": 1, "maxLength": 100000 } } },
        "sourceHint": { "$ref": "#/$defs/sourceHint" }
      }
    }
  }
}
