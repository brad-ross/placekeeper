{
  "manifest_version": 3,
  "name": "Placekeeper PDF Viewer",
  "description": "Open top-level PDFs in the installed Placekeeper viewer.",
  "version": "0.1.0",
  "minimum_chrome_version": "151",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Placekeeper PDF settings",
    "default_popup": "popup.html"
  },
  "mime_types_handler": {
    "application/pdf": {
      "handler_url": "handler.html"
    }
  }
}
