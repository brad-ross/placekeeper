{
  "name": "placekeeper-vscode",
  "displayName": "Placekeeper",
  "description": "Review generated LaTeX PDFs with Placekeeper inside VS Code.",
  "version": "0.1.0",
  "type": "module",
  "publisher": "placekeeper-local",
  "icon": "assets/placekeeper.png",
  "private": true,
  "engines": { "vscode": ">=1.95.0" },
  "extensionKind": ["ui"],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:placekeeper.open",
    "onCommand:placekeeper.viewPdf",
    "onCommand:placekeeper.forwardSyncTex",
    "onCommand:placekeeper.goToSource",
    "onCommand:placekeeper.reattach",
    "onCommand:placekeeper.exportReviewedPdf",
    "onCommand:placekeeper.configureLatexWorkshop",
    "onCommand:placekeeper.restoreLatexWorkshop",
    "onWebviewPanel:placekeeper.review",
    "onUri"
  ],
  "contributes": {
    "commands": [
      {
        "command": "placekeeper.open",
        "title": "Placekeeper: Open Local PDF",
        "icon": {
          "light": "assets/placekeeper.svg",
          "dark": "assets/placekeeper.svg"
        }
      },
      {
        "command": "placekeeper.viewPdf",
        "title": "Placekeeper: View PDF",
        "icon": { "light": "assets/placekeeper.svg", "dark": "assets/placekeeper.svg" }
      },
      {
        "command": "placekeeper.forwardSyncTex",
        "title": "Placekeeper: Forward SyncTeX"
      },
      {
        "command": "placekeeper.goToSource",
        "title": "Placekeeper: Go to Source"
      },
      {
        "command": "placekeeper.reattach",
        "title": "Placekeeper: Reattach Review Item"
      },
      {
        "command": "placekeeper.exportReviewedPdf",
        "title": "Placekeeper: Export Reviewed PDF"
      },
      {
        "command": "placekeeper.configureLatexWorkshop",
        "title": "Placekeeper: Configure LaTeX Workshop"
      },
      {
        "command": "placekeeper.restoreLatexWorkshop",
        "title": "Placekeeper: Restore LaTeX Workshop Settings"
      }
    ],
    "menus": {
      "explorer/context": [
        { "command": "placekeeper.open", "when": "resourceExtname == .pdf", "group": "navigation" }
      ],
      "editor/title": [
        { "command": "placekeeper.viewPdf", "when": "resourceExtname == .pdf || editorLangId == latex", "group": "navigation" },
        { "command": "placekeeper.forwardSyncTex", "when": "editorLangId == latex", "group": "navigation" }
      ],
      "webview/context": [
        { "command": "placekeeper.goToSource", "when": "webviewId == 'placekeeper.review'", "group": "navigation" },
        { "command": "placekeeper.exportReviewedPdf", "when": "webviewId == 'placekeeper.review'", "group": "navigation" }
      ]
    },
    "keybindings": [
      { "command": "placekeeper.forwardSyncTex", "key": "ctrl+alt+f", "mac": "cmd+alt+f", "when": "editorLangId == latex" },
      { "command": "placekeeper.goToSource", "key": "ctrl+alt+j", "mac": "cmd+alt+j", "when": "activeWebviewPanelId == 'placekeeper.review'" }
    ],
    "configuration": {
      "title": "Placekeeper",
      "properties": {
        "placekeeper.launcherPath": {
          "type": "string",
          "description": "Absolute path to the installed Placekeeper launcher."
        },
        "placekeeper.externalLauncherPath": {
          "type": "string",
          "description": "Absolute path to the installed scoped VS Code compatibility launcher. Placekeeper commands remain available when unset."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./copy-web-assets.mjs"
  }
}
