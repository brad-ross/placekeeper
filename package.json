{
  "name": "local-placekeeper",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm build:service && pnpm build:vscode && pnpm build:chrome:bundle",
    "build:service": "vite build --config apps/service/vite.config.ts",
    "prebuild:web": "pnpm catalog:check",
    "build:web": "vite build --config apps/web/vite.production.config.ts",
    "build:macos:web": "vite build --config apps/web/vite.macos.config.ts",
    "build:macos:gate": "pnpm build:macos:web",
    "build:static": "vite build --config apps/web/vite.static.config.ts",
    "build:static:pages": "PLACEKEEPER_STATIC_BASE=/placekeeper/ vite build --config apps/web/vite.static.config.ts",
    "validate:static": "node --import tsx scripts/validate-static-distribution.ts",
    "test:static:distribution": "node --import tsx scripts/testing/run-suite.ts test:static:distribution",
    "verify:static:distribution": "pnpm build:static && pnpm validate:static && pnpm test:static:distribution",
    "build:vscode": "pnpm --dir apps/vscode run build",
    "build:chrome": "pnpm build:web && pnpm build:chrome:bundle",
    "build:chrome:bundle": "vite build --config apps/chrome-extension/vite.config.ts && node --experimental-strip-types apps/chrome-extension/scripts/validate-manifest.ts",
    "catalog:generate": "tsx scripts/pdf-symbol-catalog/generate.ts",
    "catalog:audit": "tsx scripts/pdf-symbol-catalog/generate.ts --audit-only",
    "catalog:check": "tsx scripts/pdf-symbol-catalog/generate.ts --check",
    "catalog:update": "tsx scripts/pdf-symbol-catalog/update.ts",
    "icons:generate": "sh packaging/macos/icon/generate-icons.sh",
    "fixtures:pdf": "tsx test/fixtures/pdfs/generate.ts",
    "test": "node --import tsx scripts/testing/run-suite.ts test",
    "test:pdf-writer": "node --import tsx scripts/testing/run-suite.ts test:pdf-writer",
    "test:reviewed-pdf": "node --import tsx scripts/testing/run-suite.ts test:reviewed-pdf",
    "test:pdf-viewer": "node --import tsx scripts/testing/run-suite.ts test:pdf-viewer",
    "test:static:artifact": "node --import tsx scripts/testing/run-suite.ts test:static:artifact",
    "test:static:secondary-full": "node --import tsx scripts/testing/run-suite.ts test:static:secondary-full",
    "test:static:unit": "node --import tsx scripts/testing/run-suite.ts test:static:unit",
    "test:static:conformance": "node --import tsx scripts/testing/run-suite.ts test:static:conformance",
    "test:static": "node --import tsx scripts/testing/run-suite.ts test:static",
    "test:static:pr": "node --import tsx scripts/testing/run-suite.ts test:static:pr",
    "smoke:static-pages": "node --import tsx scripts/smoke-static-site.ts",
    "test:pdf-conformance": "node --import tsx scripts/testing/run-suite.ts test:pdf-conformance",
    "test:chrome-extension": "node --import tsx scripts/testing/run-suite.ts test:chrome-extension",
    "test:chrome-runtime": "node --import tsx scripts/testing/run-suite.ts test:chrome-runtime",
    "test:chrome-handoff:unit": "node --import tsx scripts/testing/run-suite.ts test:chrome-handoff:unit",
    "test:chrome-handoff": "node --import tsx scripts/testing/run-suite.ts test:chrome-handoff",
    "test:chrome-installed": "node --import tsx scripts/testing/run-suite.ts test:chrome-installed",
    "test:service": "node --import tsx scripts/testing/run-suite.ts test:service",
    "test:security": "node --import tsx scripts/testing/run-suite.ts test:security",
    "test:web": "node --import tsx scripts/testing/run-suite.ts test:web",
    "test:review": "node --import tsx scripts/testing/run-suite.ts test:review",
    "test:u4": "pnpm test:review",
    "test:u5": "pnpm test:save-export",
    "test:u6": "pnpm test:source-rebuild",
    "test:e2e": "node --import tsx scripts/testing/run-suite.ts test:e2e",
    "test:e2e:webkit": "node --import tsx scripts/testing/run-suite.ts test:e2e:webkit",
    "test:visual": "node --import tsx scripts/testing/run-suite.ts test:visual",
    "test:u7-host": "pnpm test:host-integration",
    "test:upgrade-lifecycle": "node --import tsx scripts/testing/run-suite.ts test:upgrade-lifecycle",
    "test:u7": "pnpm test:production-integration",
    "test:u8": "pnpm test:full-validation",
    "test:ci:unit": "node --import tsx scripts/testing/run-suite.ts test:ci:unit",
    "test:ci:chromium": "node --import tsx scripts/testing/run-suite.ts test:ci:chromium",
    "test:ci:webkit": "node --import tsx scripts/testing/run-suite.ts test:ci:webkit",
    "test:ci:visual": "node --import tsx scripts/testing/run-suite.ts test:ci:visual",
    "test:ci": "node --import tsx scripts/testing/run-suite.ts test:ci",
    "validate:distribution": "pnpm build && node --check dist/service/main.js && tsx packaging/macos/validate-manifest.ts",
    "package:macos": "pnpm build && pnpm build:macos:web && tsx packaging/macos/build-native-candidate.ts",
    "package:macos:native-candidate": "pnpm build && pnpm build:macos:web && tsx packaging/macos/build-native-candidate.ts",
    "run:macos:native-candidate": "tsx packaging/macos/run-native-candidate.ts",
    "install:local": "/bin/sh ./install.sh",
    "notarize:macos": "tsx packaging/macos/notarize.ts",
    "smoke:installed": "tsx packaging/macos/smoke-installed.ts",
    "spike:electron": "pnpm --dir apps/electron-spike start",
    "test:electron-spike": "node --import tsx scripts/testing/run-suite.ts test:electron-spike",
    "test:macos:native": "node --import tsx scripts/testing/run-suite.ts test:macos:native",
    "test:macos:gate": "node --import tsx scripts/testing/run-suite.ts test:macos:gate",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "lint": "tsc -p tsconfig.base.json --noEmit",
    "test:save-export": "node --import tsx scripts/testing/run-suite.ts test:save-export",
    "test:source-rebuild": "node --import tsx scripts/testing/run-suite.ts test:source-rebuild",
    "test:host-integration": "node --import tsx scripts/testing/run-suite.ts test:host-integration",
    "test:production-integration": "node --import tsx scripts/testing/run-suite.ts test:production-integration",
    "test:full-validation": "node --import tsx scripts/testing/run-suite.ts test:full-validation",
    "package:source-release": "node --import tsx scripts/package-source-release.ts",
    "test:source-release": "node --import tsx scripts/testing/run-suite.ts test:source-release"
  },
  "dependencies": {
    "@embedpdf/core": "2.14.4",
    "@embedpdf/engines": "2.14.4",
    "@embedpdf/models": "2.14.4",
    "@embedpdf/pdfium": "2.14.4",
    "@embedpdf/plugin-annotation": "2.14.4",
    "@embedpdf/plugin-document-manager": "2.14.4",
    "@embedpdf/plugin-interaction-manager": "2.14.4",
    "@embedpdf/plugin-render": "2.14.4",
    "@embedpdf/plugin-scroll": "2.14.4",
    "@embedpdf/plugin-selection": "2.14.4",
    "@embedpdf/plugin-viewport": "2.14.4",
    "@embedpdf/plugin-zoom": "2.14.4",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "lucide-react": "1.27.0",
    "pdf-lib": "1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "fast-xml-parser": "5.11.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
